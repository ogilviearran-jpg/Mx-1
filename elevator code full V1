void setup() {

// put your setup code here, to run once:

pinMode(dig1,INPUT);
pinMode(dig2,INPUT);
pinMode(dig3,INPUT);
//Serial.begin(9600); 

//7-segment display
pinMode(14,OUTPUT);
pinMode(15,OUTPUT);

//motors
pinMode(pHoistDir, OUTPUT);
pinMode(pHoistPwm, OUTPUT);
}

 

