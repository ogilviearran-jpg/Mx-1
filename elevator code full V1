//Functions -----------------------------------------


//function for elevator moving up
void MoveUp()
{
  digitalWrite(pHoistDir, 1);
  analogWrite(pHoistPwm, Mspeed);
  }


//function for elevator moving down
void MoveDown()
{
  digitalWrite(pHoistDir, 0);
  analogWrite(pHoistPwm, Mspeed);
  }


//function for motor stop
void MotorStop()
{
  Mspeed = 0;
  analogWrite(pHoistPwm, Mspeed);
  }


//function for elevator acceleration
void CarAcceleration()
{
  //accelerate lift
  while (Mspeed < 200)
  {
    Mspeed += 20;
    //Serial.println(Mspeed);
    //delay(100);
    }
  }


//function for elevator Decceleration
void CarDecceleration()
{
  //deccelerate lift
  while (Mspeed > 20)
  {
    Mspeed -= 20;
    //Serial.println(Mspeed);
    //delay(100);

    //instructions to motor
    analogWrite(pHoistPwm, Mspeed);
    }
  }

//function for controling elevator movement
void Movement()
{
  if (CurrentPos < destination and CurrentPos != (destination - 1))
   {
    //accelerate lift
    CarAcceleration();

     //instructions to motor
     MoveUp();
    }


  //for elevator moving down-------------
  if (CurrentPos > destination and CurrentPos != (destination + 1))
   {
    //accelerate lift
    CarAcceleration();

      //instructions to motor
      MoveDown();
    }


  //for elevator approaching destination--------------------
  if (CurrentPos == (destination - 1) or CurrentPos == (destination + 1))
  {
    //deccelerate lift
    CarDecceleration();
    }



  //for elevator at destination-----------------------
  if (CurrentPos == destination)
  {
    //Serial.println(Mspeed);
    //delay(100);
        
    //instructions to motor
    MotorStop();
    }
  }

//function for using seven segment display
void SevenSegment()
{
  switch (CurrentPos)
  {
    case 1:
      DisplayPos1 = 0;
      DisplayPos2 = 1;
      break;
  
     case 4:
      DisplayPos1 = 1;
      DisplayPos2 = 0;
      break;
  
     case 7:
      DisplayPos1 = 1;
      DisplayPos2 = 1;
      break;
    }
  }

