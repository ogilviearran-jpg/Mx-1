void setup() {

// put your setup code here, to run once:

pinMode(dig1,INPUT);
pinMode(dig2,INPUT);
pinMode(dig3,INPUT);
Serial.begin(9600); 

//7-segment display
pinMode(14,OUTPUT);
pinMode(15,OUTPUT);
}

 

void loop() {

// put your main code here, to run repeatedly:


//floor sensors ------------------------
LSD=digitalRead(dig1); 
Middle=digitalRead(dig2); 
MSD=digitalRead(dig3); \

int sensors =(LSD)+(Middle<<1)+(MSD<<2);

if (sensors != 0)
{
  CurrentPos = sensors;
  }

// This turns our binary number into a decimal. Starting from the least significant figure (LSD) we then add the other two digits but must shift them one (<<1) or two (<<2) place(s)  to the left so that 1+1+1 is not 3 but 111 which is actually 7.


SevenSegment();
//Serial.println(CurrentPos); 

//delay(1000);

//floor sensors end ------------------------

//7-segment display ----------------------


  digitalWrite(14,DisplayPos1);
  digitalWrite(15,DisplayPos2);

//7-segment display end ----------------------

//Yellow buttons -----------------------------

 int sensorValue = analogRead(buttonPin);

   if (sensorValue < 100){
    buttonState = 0;
  }
 
  else if (sensorValue >= 100 && sensorValue < 310){
    buttonState = 1;
  }
 
  else if (sensorValue >= 310 && sensorValue < 500){
    buttonState = 3;
  }
 
  else if (sensorValue >= 500 && sensorValue < 690){
    buttonState = 2;
  }
 
  else if (sensorValue >= 690){
    buttonState = 4;
  }


 if (CurrentPos == 7 and buttonState == 1)
 {
  destination = 1;
  Serial.println("Move down to floor 1");
  delay(1000);
  }

if (CurrentPos == 7 and buttonState == 2)
 {
  destination = 4;
    Serial.println("Move down to floor 2");
  delay(1000);
  }

  if (CurrentPos == 1 and buttonState == 3)
 {
  destination = 4;
    Serial.println("Move up to floor 2");
  delay(1000);
  }

if (CurrentPos == 1 and buttonState == 4)
 {
  destination = 7;
      Serial.println("Move up to floor 3");
  delay(1000);
  }

  if (CurrentPos == 4 and buttonState == 1)
 {
  destination = 1;
    Serial.println("Move down to floor 1");
  delay(1000);
  }

if (CurrentPos == 4 and buttonState == 4)
 {
  destination = 7;
      Serial.println("Move up to floor 3");
  delay(1000);
  }
 
 //Yellow buttons end -----------------------------

}
