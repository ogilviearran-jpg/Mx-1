int CurrentPos = 1;
int Destination = 0;

uint8_t pHoistDir = 7;
uint8_t pHoistPwm = 5; //controls Hoist(Car) Motor speed ; values can be 0 (off)..255 (maximum)
uint8_t Mspeed = 0;

void setup() {
  // put your setup code here, to run once:

  pinMode(pHoistDir, OUTPUT);
  pinMode(pHoistPwm, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  // put your main code here, to run repeatedly:#


  //for elevator moving up--------------
  if (CurrentPos < Destination and CurrentPos != (Destination - 1))
   {
    //accelerate lift
      while (Mspeed < 200)
      {
        Mspeed += 20;
        Serial.println(Mspeed);
        delay(100);
        }

      //instructions to motor
      digitalWrite(pHoistDir, 1);
      analogWrite(pHoistPwm, Mspeed);
    }


    //for elevator moving down-------------
  if (CurrentPos > Destination and CurrentPos != (Destination + 1))
   {
    //accelerate lift
      while (Mspeed < 200)
      {
        Mspeed += 20;
        Serial.println(Mspeed);
        delay(100);
        }

      //instructions to motor
      digitalWrite(pHoistDir, 0);
      analogWrite(pHoistPwm, Mspeed);
    }


    //for elevator approaching destination
    if (CurrentPos == (Destination - 1) or CurrentPos == (Destination + 1))
    {
      //decelerate lift
      while (Mspeed > 20)
      {
        Mspeed -= 20;
        Serial.println(Mspeed);
        delay(100);
        }
      }
}
